APP_NAME=Vitafolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

# the cache driver with the database store works across every copy of the app and survives redeploys
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8. SQLite also works for local development.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vitafolio
DB_USERNAME=vitafolio
DB_PASSWORD=
# path to the database provider's CA certificate when it requires TLS
MYSQL_ATTR_SSL_CA=

# sessions and cache live in the database, so restarts never sign anyone out or reset rate limits
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# "log" writes emails to the log locally; use "resend" with RESEND_API_KEY in production
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# site details shown in the footer and used for contact; leave blank to hide them
SITE_OWNER_NAME="Your Name"
SITE_OWNER_URL="https://example.com"
SITE_CONTACT_EMAIL="hello@example.com"
SITE_SECURITY_EMAIL="security@example.com"
SITE_LINKEDIN_URL=
SITE_SOURCE_URL="https://github.com/your-name/vitafolio"
SITE_STATUS_URL=

# cloudflare turnstile spam protection; forms work without it when these are blank
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# cloudflare web analytics token; analytics stay off when blank
CF_BEACON_TOKEN=

# sign-in providers; each button only appears once its id and secret are set. the callback
# address to register with each provider is APP_URL followed by /auth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common allows personal, work and school accounts; set a tenant id to allow one organisation only
MICROSOFT_TENANT=common
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# storage per account in MB, counting cv files and project media
STORAGE_ALLOWANCE_MB=100

# shared secret for the nightly tidy-up call to /cron (any long random string); off when blank
CRON_TOKEN=

# the typst binary for tagged cv pdfs (https://typst.app); without it pdfs are made untagged
TYPST_BINARY=typst

# error tracking; off when blank
SENTRY_LARAVEL_DSN=
# the error tracker's security endpoint, so content security policy breaks are reported; off when blank
CSP_REPORT_URI=

# passkeys derive each account's opaque handle from this; set it before the first passkey is
# created and never change it, so rotating APP_KEY later does not break passkeys
PASSKEYS_USER_HANDLE_SECRET=

# indexnow key, any 8 to 128 letters, digits or dashes; search engine pings stay off when blank
INDEXNOW_KEY=

# cloudinary for project images and videos; the media fields are hidden when these are blank
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# where the in-browser latex engine files are hosted; compiling is unavailable when blank
LATEX_ASSETS_URL=

VITE_APP_NAME="${APP_NAME}"
